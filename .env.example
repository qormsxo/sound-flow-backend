# ===== App =====
PORT=3000
NODE_ENV=development

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=sound_flow
DB_SYNCHRONIZE=true

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 검색 결과 캐시 TTL(초)
SEARCH_CACHE_TTL=60

# 재생/다운로드 카운트를 DB에 반영(flush)하는 배치 주기(ms)
COUNTER_FLUSH_INTERVAL_MS=10000

# ===== AI (OpenAI 호환 엔드포인트) =====
# 미설정 시 Mock 스트리밍 응답으로 동작 (PoC 데모용)
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini

# ===== OpenAI (모아리 AI 캐릭터 챗) =====
# 실제 OpenAI API를 사용하는 /moari/chat/stream 엔드포인트에서 사용됩니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
